{
  "name": "dsh-git-worktree",
  "version": "0.2.0",
  "description": "DSH plugin: branch visibility and git worktree isolation for Web UI sessions",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/LaoYueHanNi/dsh-git-worktree.git"
  },
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wire": {
      "types": "./lib/wire.d.ts",
      "default": "./lib/wire.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build:all": "npm run build && npm run build:client",
    "watch:client": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.4",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "playwright-core": "^1.55.1",
    "react": "^18.2.0",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19"
  }
}
