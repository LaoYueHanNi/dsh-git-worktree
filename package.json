{
  "name": "@laoyuehanni/dsh-git-worktree",
  "version": "0.4.5",
  "description": "DSH plugin: branch visibility and git worktree isolation for Web UI sessions",
  "keywords": [
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "git",
    "worktree",
    "branch"
  ],
  "homepage": "https://github.com/LaoYueHanNi/dsh-git-worktree#readme",
  "bugs": {
    "url": "https://github.com/LaoYueHanNi/dsh-git-worktree/issues"
  },
  "license": "MIT",
  "author": "LaoYueHanNi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaoYueHanNi/dsh-git-worktree.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wire": {
      "types": "./lib/wire.d.ts",
      "default": "./lib/wire.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build:all": "pnpm run build && pnpm run build:client",
    "watch:client": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build:all"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-api-gateway": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "playwright-core": "^1.55.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zustand": "~4.4.7"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.8.0"
}
